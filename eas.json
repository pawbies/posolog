{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "VARIANT": "development" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "VARIANT": "preview" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": { "VARIANT": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
